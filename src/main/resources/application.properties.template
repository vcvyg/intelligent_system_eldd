# Local configuration template
#
# The tracked application.properties reads credentials from environment variables.
# Prefer exporting those variables instead of committing real values here.

spring.application.name=Persion
server.port=8080

# SQL Server
spring.datasource.driver-class-name=com.microsoft.sqlserver.jdbc.SQLServerDriver
spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=elderly_care;encrypt=true;trustServerCertificate=true
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD

# Redis
spring.data.redis.host=localhost
spring.data.redis.port=6379
spring.data.redis.password=
spring.data.redis.database=0

# JWT - generate a long random value for local use; never reuse production secrets.
jwt.secret=CHANGE_ME_TO_A_LONG_RANDOM_LOCAL_SECRET
jwt.expiration=86400000

# Mail (optional)
spring.mail.host=smtp.qq.com
spring.mail.port=587
spring.mail.username=YOUR_MAIL_ADDRESS
spring.mail.password=YOUR_MAIL_AUTH_CODE

# Admin invitation
admin.invitation-code=CHANGE_ME_LOCAL_INVITATION_CODE

# AMap (optional while location tasks are disabled)
amap.api.key=YOUR_AMAP_API_KEY
location.task.enabled=false

# Optional medical AI model; both capabilities are disabled by default.
# Fact rewriting and semantic planning can be enabled independently.
medical.ai.enabled=false
medical.ai.planner-enabled=false
medical.ai.base-url=
medical.ai.api-key=
medical.ai.model=
medical.ai.timeout-ms=5000

# Reliable proactive-care event delivery. Execute sql/add_recommendation_center.sql first.
medical.ai.care-outbox.enabled=true
medical.ai.care-outbox.batch-size=25
medical.ai.care-outbox.fixed-delay-ms=10000

# Uploads
file.upload.path=./uploads
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB
